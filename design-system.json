{
    "designSystem": {
        "name": "RestroBit POS Design System",
        "version": "1.0.0",
        "description": "Complete design system for Restaurant POS and Reservation Management Platform",

        "colors": {
            "light": {
                "primary": {
                    "main": "#FF6B2C",
                    "hover": "#FF5515",
                    "active": "#E55A1F",
                    "light": "#FFF3EE",
                    "gradient": "linear-gradient(135deg, #FF6B2C 0%, #FF8A5C 100%)"
                },
                "secondary": {
                    "main": "#2DD4BF",
                    "hover": "#14B8A6",
                    "light": "#CCFBF1"
                },
                "success": {
                    "main": "#10B981",
                    "hover": "#059669",
                    "light": "#D1FAE5"
                },
                "error": {
                    "main": "#EF4444",
                    "hover": "#DC2626",
                    "light": "#FEE2E2"
                },
                "warning": {
                    "main": "#F59E0B",
                    "light": "#FEF3C7"
                },
                "neutral": {
                    "white": "#FFFFFF",
                    "gray50": "#F9FAFB",
                    "gray100": "#F3F4F6",
                    "gray200": "#E5E7EB",
                    "gray300": "#D1D5DB",
                    "gray400": "#9CA3AF",
                    "gray500": "#6B7280",
                    "gray600": "#4B5563",
                    "gray700": "#374151",
                    "gray800": "#1F2937",
                    "gray900": "#111827",
                    "black": "#000000"
                },
                "background": {
                    "primary": "#FFFFFF",
                    "secondary": "#F9FAFB",
                    "tertiary": "#F3F4F6"
                },
                "text": {
                    "primary": "#111827",
                    "secondary": "#6B7280",
                    "tertiary": "#9CA3AF",
                    "inverse": "#FFFFFF"
                },
                "border": {
                    "default": "#E5E7EB",
                    "focus": "#FF6B2C",
                    "hover": "#D1D5DB"
                }
            },
            "dark": {
                "primary": {
                    "main": "#FF6B2C",
                    "hover": "#FF8A5C",
                    "active": "#FF5515",
                    "light": "#2D1810",
                    "gradient": "linear-gradient(135deg, #FF6B2C 0%, #FF8A5C 100%)"
                },
                "secondary": {
                    "main": "#2DD4BF",
                    "hover": "#5EEAD4",
                    "light": "#134E4A"
                },
                "success": {
                    "main": "#10B981",
                    "hover": "#34D399",
                    "light": "#064E3B"
                },
                "error": {
                    "main": "#EF4444",
                    "hover": "#F87171",
                    "light": "#7F1D1D"
                },
                "warning": {
                    "main": "#F59E0B",
                    "light": "#78350F"
                },
                "neutral": {
                    "white": "#FFFFFF",
                    "gray50": "#18181B",
                    "gray100": "#27272A",
                    "gray200": "#3F3F46",
                    "gray300": "#52525B",
                    "gray400": "#71717A",
                    "gray500": "#A1A1AA",
                    "gray600": "#D4D4D8",
                    "gray700": "#E4E4E7",
                    "gray800": "#F4F4F5",
                    "gray900": "#FAFAFA",
                    "black": "#000000"
                },
                "background": {
                    "primary": "#0F0F0F",
                    "secondary": "#18181B",
                    "tertiary": "#27272A"
                },
                "text": {
                    "primary": "#FAFAFA",
                    "secondary": "#A1A1AA",
                    "tertiary": "#71717A",
                    "inverse": "#111827"
                },
                "border": {
                    "default": "#3F3F46",
                    "focus": "#FF6B2C",
                    "hover": "#52525B"
                }
            }
        },

        "typography": {
            "fontFamily": {
                "primary": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
                "mono": "JetBrains Mono, Consolas, Monaco, monospace"
            },
            "fontSize": {
                "xs": "0.75rem",
                "sm": "0.875rem",
                "base": "1rem",
                "lg": "1.125rem",
                "xl": "1.25rem",
                "2xl": "1.5rem",
                "3xl": "1.875rem",
                "4xl": "2.25rem",
                "5xl": "3rem"
            },
            "fontWeight": {
                "normal": "400",
                "medium": "500",
                "semibold": "600",
                "bold": "700"
            },
            "lineHeight": {
                "tight": "1.25",
                "normal": "1.5",
                "relaxed": "1.75"
            }
        },

        "spacing": {
            "0": "0",
            "1": "0.25rem",
            "2": "0.5rem",
            "3": "0.75rem",
            "4": "1rem",
            "5": "1.25rem",
            "6": "1.5rem",
            "8": "2rem",
            "10": "2.5rem",
            "12": "3rem",
            "16": "4rem",
            "20": "5rem",
            "24": "6rem"
        },

        "borderRadius": {
            "none": "0",
            "sm": "0.25rem",
            "md": "0.375rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "2xl": "1rem",
            "3xl": "1.5rem",
            "full": "9999px"
        },

        "shadows": {
            "light": {
                "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)",
                "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06)",
                "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05)",
                "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)",
                "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.25)"
            },
            "dark": {
                "sm": "0 1px 2px 0 rgba(0, 0, 0, 0.3)",
                "md": "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -1px rgba(0, 0, 0, 0.3)",
                "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.4)",
                "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 10px 10px -5px rgba(0, 0, 0, 0.5)",
                "2xl": "0 25px 50px -12px rgba(0, 0, 0, 0.7)"
            }
        },

        "components": {
            "button": {
                "primary": {
                    "padding": "0.625rem 1.5rem",
                    "borderRadius": "0.5rem",
                    "fontSize": "0.875rem",
                    "fontWeight": "600",
                    "transition": "all 0.2s ease"
                },
                "secondary": {
                    "padding": "0.625rem 1.5rem",
                    "borderRadius": "0.5rem",
                    "fontSize": "0.875rem",
                    "fontWeight": "600",
                    "borderWidth": "1px"
                },
                "icon": {
                    "padding": "0.5rem",
                    "borderRadius": "0.5rem"
                },
                "sizes": {
                    "sm": {
                        "padding": "0.5rem 1rem",
                        "fontSize": "0.75rem"
                    },
                    "md": {
                        "padding": "0.625rem 1.5rem",
                        "fontSize": "0.875rem"
                    },
                    "lg": {
                        "padding": "0.75rem 2rem",
                        "fontSize": "1rem"
                    }
                }
            },

            "card": {
                "padding": "1.5rem",
                "borderRadius": "1rem",
                "borderWidth": "1px",
                "shadow": "md"
            },

            "input": {
                "padding": "0.625rem 1rem",
                "borderRadius": "0.5rem",
                "borderWidth": "1px",
                "fontSize": "0.875rem"
            },

            "modal": {
                "overlay": {
                    "backdropBlur": "4px",
                    "backgroundColor": "rgba(0, 0, 0, 0.5)"
                },
                "content": {
                    "borderRadius": "1rem",
                    "padding": "2rem",
                    "maxWidth": "32rem",
                    "shadow": "2xl"
                }
            },

            "sidebar": {
                "width": "280px",
                "padding": "1.5rem",
                "gap": "0.5rem"
            },

            "table": {
                "headerPadding": "1rem",
                "cellPadding": "1rem",
                "borderRadius": "0.75rem",
                "rowHoverTransition": "all 0.15s ease"
            },

            "badge": {
                "padding": "0.25rem 0.75rem",
                "borderRadius": "9999px",
                "fontSize": "0.75rem",
                "fontWeight": "600"
            },

            "productCard": {
                "padding": "1rem",
                "borderRadius": "0.75rem",
                "imageAspectRatio": "1/1",
                "imageBorderRadius": "0.5rem",
                "gap": "0.75rem"
            }
        },

        "layout": {
            "sidebar": {
                "width": "280px",
                "collapsedWidth": "80px"
            },
            "header": {
                "height": "64px"
            },
            "container": {
                "maxWidth": "1280px",
                "padding": "1.5rem"
            },
            "grid": {
                "gap": "1.5rem",
                "columns": {
                    "sm": 1,
                    "md": 2,
                    "lg": 3,
                    "xl": 4
                }
            }
        },

        "animations": {
            "transition": {
                "fast": "150ms ease",
                "normal": "200ms ease",
                "slow": "300ms ease"
            },
            "keyframes": {
                "fadeIn": {
                    "from": { "opacity": 0 },
                    "to": { "opacity": 1 }
                },
                "slideIn": {
                    "from": { "transform": "translateX(-100%)" },
                    "to": { "transform": "translateX(0)" }
                },
                "scaleIn": {
                    "from": { "transform": "scale(0.95)", "opacity": 0 },
                    "to": { "transform": "scale(1)", "opacity": 1 }
                }
            }
        },

        "breakpoints": {
            "sm": "640px",
            "md": "768px",
            "lg": "1024px",
            "xl": "1280px",
            "2xl": "1536px"
        }
    },

    "pageLayouts": {
        "pos": {
            "structure": "sidebar + main + rightPanel",
            "sidebar": {
                "items": [
                    "Dashboard",
                    "POS",
                    "Menu",
                    "Tables",
                    "Reservations",
                    "Orders",
                    "Delivery Executive",
                    "Payments",
                    "Customer",
                    "Invoice",
                    "Testimonial",
                    "User",
                    "Reports",
                    "Setting"
                ]
            },
            "main": {
                "sections": ["categoryFilter", "productGrid"]
            },
            "rightPanel": {
                "sections": ["orderSummary", "customerInfo", "actions"]
            }
        },
        "payment": {
            "modal": true,
            "sections": [
                "orderDetails",
                "paymentMethods",
                "calculator",
                "actions"
            ]
        }
    },

    "uiPatterns": {
        "navigation": {
            "type": "sidebar",
            "itemPadding": "0.75rem 1rem",
            "itemGap": "0.25rem",
            "iconSize": "1.25rem",
            "activeIndicator": "leftBorder"
        },
        "productDisplay": {
            "type": "grid",
            "imageFirst": true,
            "priceDisplay": "bottom",
            "hoverEffect": "lift"
        },
        "orderSummary": {
            "type": "list",
            "itemLayout": "horizontal",
            "quantityControl": "inline",
            "priceAlignment": "right"
        },
        "forms": {
            "labelPosition": "top",
            "errorPosition": "bottom",
            "helperTextSize": "0.75rem"
        }
    }
}
